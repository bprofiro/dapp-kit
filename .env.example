# Tudo que começa com NEXT_PUBLIC_ vai para o bundle do navegador.
# Nunca coloque segredo aqui. Use chaves de RPC restritas por domínio no painel do provedor.

# https://cloud.reown.com — cadastre o domínio de produção na allowlist do projeto
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# URL pública do app (vai no metadata do WalletConnect; precisa bater com o domínio real)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RPCs dedicados (opcional; sem eles cai no RPC público da chain, que tem rate limit)
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
