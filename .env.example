# Anything prefixed with NEXT_PUBLIC_ ends up in the browser bundle.
# Never put secrets here. Use RPC keys restricted by domain in your provider's dashboard.

# https://cloud.reown.com — add your production domain to the project's allowlist
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public URL of the app (used in WalletConnect metadata; must match the real domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated RPCs (optional; without them the chain's public RPC is used, which is rate limited)
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
